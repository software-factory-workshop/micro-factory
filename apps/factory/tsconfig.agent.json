{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node",
      "eve/workflow-modules"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "runtime/**/*.ts",
    "agents/**/*.ts"
  ],
  "exclude": [
    "agents/*/agent/skills/**"
  ]
}